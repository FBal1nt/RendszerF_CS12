@page
@model JegyMester.Pages.Film.IndexModel

<p>
    <a asp-page="Create" class="btn btn-success">Create New</a>
    <a asp-page="/AdminIndex" class="btn btn-secondary">Vissza az Admin oldalra</a>
</p>
<table class="table">
    <thead>
        <tr>
            <th>
                @Html.DisplayNameFor(model => model.Film[0].Title)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.Film[0].Genre)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.Film[0].DurationInMinutes)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.Film[0].Director)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.Film[0].ReleaseDate)
            </th>
            <th>Kép</th>
            <th></th>
        </tr>
    </thead>
    <tbody>
@foreach (var item in Model.Film) {
        <tr>
            <td>
                @Html.DisplayFor(modelItem => item.Title)
            </td>
            <td>
                @Html.DisplayFor(modelItem => item.Genre)
            </td>
            <td>
                @Html.DisplayFor(modelItem => item.DurationInMinutes)
            </td>
            <td>
                @Html.DisplayFor(modelItem => item.Director)
            </td>
            <td>
                @Html.DisplayFor(modelItem => item.ReleaseDate)
            </td>
                <td>
                    @if (!string.IsNullOrEmpty(item.ImagePath))
                    {
                        <img src="@item.ImagePath" alt="Plakát" style="height: 50px; width: 35px; object-fit: cover; border-radius: 4px;" />
                    }
                    else
                    {
                        <span class="text-muted small">Nincs kép</span>
                    }
                </td>
            <td>
                <a asp-page="./Edit" asp-route-id="@item.Id" class="link-edit">Edit</a> |
                <a asp-page="./Details" asp-route-id="@item.Id" class="link-details">Details</a> |
                <a asp-page="./Delete" asp-route-id="@item.Id" class="link-delete">Delete</a>
            </td>
        </tr>
}
    </tbody>
</table>
