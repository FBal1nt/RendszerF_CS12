@page
@model JegyMester.Pages.Film.CreateModel

<h4>Film Létrehozása</h4>
<hr />
<div class="row">
    <div class="col-md-4">
        <form method="post" enctype="multipart/form-data">
            <div asp-validation-summary="ModelOnly" class="text-danger"></div>

            <div class="form-group">
                <label asp-for="Film.Title" class="control-label"></label>
                <input asp-for="Film.Title" class="form-control" />
                <span asp-validation-for="Film.Title" class="text-danger"></span>
            </div>

            <div class="form-group">
                <label asp-for="Film.Genre" class="control-label"></label>
                <select asp-for="Film.Genre" asp-items="Model.GenreSelectList" class="form-control"></select>
                <span asp-validation-for="Film.Genre" class="text-danger"></span>
            </div>

            <div class="form-group">
                <label asp-for="Film.DurationInMinutes" class="control-label"></label>
                <input asp-for="Film.DurationInMinutes" class="form-control" />
                <span asp-validation-for="Film.DurationInMinutes" class="text-danger"></span>
            </div>

            <div class="form-group">
                <label asp-for="Film.Director" class="control-label"></label>
                <input asp-for="Film.Director" class="form-control" />
                <span asp-validation-for="Film.Director" class="text-danger"></span>
            </div>

            <div class="form-group">
                <label asp-for="Film.ReleaseDate" class="control-label"></label>
                <input asp-for="Film.ReleaseDate" class="form-control" type="date" />
                <span asp-validation-for="Film.ReleaseDate" class="text-danger"></span>
            </div>

            <div class="form-group mt-2">
                <label class="control-label">Borítókép feltöltése</label>
                <input type="file" name="ImageUpload" class="form-control" accept="image/*" />
            </div>

            <div class="form-group mt-3">
                <input type="submit" value="Létrehozás" class="btn btn-primary" />
            </div>
        </form>
    </div>
</div>

<div class="mt-2">
    <a asp-page="Index">Vissza a listához</a>
</div>