@page
@model JegyMester.Pages.Film.DeleteModel

<h3>Are you sure you want to delete this?</h3>
<div>
    <h4>Film</h4>
    <hr />
    <dl class="row">
        <dt class="col-sm-2">
            @Html.DisplayNameFor(model => model.Film.Title)
        </dt>
        <dd class="col-sm-10">
            @Html.DisplayFor(model => model.Film.Title)
        </dd>
        <dt class="col-sm-2">
            @Html.DisplayNameFor(model => model.Film.Genre)
        </dt>
        <dd class="col-sm-10">
            @Html.DisplayFor(model => model.Film.Genre)
        </dd>
        <dt class="col-sm-2">
            @Html.DisplayNameFor(model => model.Film.DurationInMinutes)
        </dt>
        <dd class="col-sm-10">
            @Html.DisplayFor(model => model.Film.DurationInMinutes)
        </dd>
        <dt class="col-sm-2">
            @Html.DisplayNameFor(model => model.Film.Director)
        </dt>
        <dd class="col-sm-10">
            @Html.DisplayFor(model => model.Film.Director)
        </dd>
        <dt class="col-sm-2">
            @Html.DisplayNameFor(model => model.Film.ReleaseDate)
        </dt>
        <dd class="col-sm-10">
            @Html.DisplayFor(model => model.Film.ReleaseDate)
        </dd>
        <dt class="col-sm-2">Borítókép</dt>
        <dd class="col-sm-10">
            @if (!string.IsNullOrEmpty(Model.Film.ImagePath))
            {
                <img src="@Model.Film.ImagePath" alt="Borítókép" style="max-height: 200px; border-radius: 8px;" />
            }
            else
            {
                <span>Nincs feltöltve kép</span>
            }
        </dd>
    </dl>
    
    <form method="post">
        <input type="hidden" asp-for="Film.Id" />
        <input type="submit" value="Delete" class="btn btn-danger" /> |
        <a asp-page="./Index">Back to List</a>
    </form>
</div>
