@page
@model IndexModel

<div class="container mt-5">
    <div class="text-center mb-5">
        <h1 class="display-4 fw-bold">🎬 Üdv a JegyMesterben!</h1>
        <p style="color:white">Foglalj helyet a legjobb filmekre, gyorsan és egyszerűen.</p>
    </div>

    <!-- Kártyák középre igazítása -->
    <div class="row g-4 justify-content-center">

        <!-- Filmek -->
        <div class="col-md-4">
            <div class="card h-100 menu-card">
                <div class="card-body text-center">
                    <h3 class="card-title">
                        <a href="/FilmekLista" class="stretched-link text-decoration-none">🎞 Filmek</a>
                    </h3>
                    <p class="card-text">Böngéssz a jelenleg futó filmek között.</p>
                </div>
            </div>
        </div>

        <!-- Vetítések -->
        <div class="col-md-4">
            <div class="card h-100 menu-card">
                <div class="card-body text-center">
                    <h3 class="card-title">
                        <a href="/VetitesekLista" class="stretched-link text-decoration-none">🕒 Vetítések</a>
                    </h3>
                    <p class="card-text">Nézd meg a közelgő előadásokat.</p>
                </div>
            </div>
        </div>

        <!-- Jegyeim – csak bejelentkezve -->
        @if (User.Identity?.IsAuthenticated == true)
        {
            <div class="col-md-4">
                <div class="card h-100 menu-card">
                    <div class="card-body text-center">
                        <h3 class="card-title">
                            <a href="/Tickets/MyTickets" class="stretched-link text-decoration-none">🎫 Jegyeim</a>
                        </h3>
                        <p class="card-text">Korábbi vásárlásaid egy helyen.</p>
                    </div>
                </div>
            </div>
        }

    </div>
</div>
