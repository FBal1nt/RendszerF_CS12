@page
@model JegyMester.Pages.VetitesekListaModel

<h3>VETITÉSEK</h3>
<hr />

@if (Model.Vetitesek?.Any() != true)
{
    <p>Nincsenek vetítések a listában.</p>
}
else
{
    <ul class="list-group">
        @foreach (var v in Model.Vetitesek)
        {
            <li class="list-group-item">
                <div class="fw-bold">@v.Film?.Title</div>
                <div class="text-muted small">
                    Mozi: @(v.Room?.Cinema != null ? v.Room.Cinema.Name : "Ismeretlen")<br />
                    Terem: @(v.Room != null ? v.Room.Id.ToString() : "Ismeretlen")<br />
                    Kezdés: @v.StartTime.ToString("yyyy.MM.dd. HH:mm")<br />
                    Befejezés: @v.EndTime.ToString("yyyy.MM.dd. HH:mm")
                </div>

                <div class="mt-2">
                    <a asp-page="/Tickets/Buy"
                           asp-route-id="@v.Id"
                           class="btn btn-success btn-sm">
                        Jegyvásárlás
                    </a>
                </div>
            </li>
        }
    </ul>
}
