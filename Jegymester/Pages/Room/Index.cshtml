@page
@model JegyMester.Pages.Room.IndexModel

<p>
    <a asp-page="Create" class="btn btn-success">Create New</a>
    <a asp-page="/AdminIndex" class="btn btn-secondary">Vissza az Admin oldalra</a>
</p>
<table class="table">
    <thead>
        <tr>
            <th>
                @Html.DisplayNameFor(model => model.Room[0].Cinema)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.Room[0].RoomNumber)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.Room[0].RowCount)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.Room[0].SeatsPerRow)
            </th>
            <th></th>
        </tr>
    </thead>
    <tbody>
@foreach (var item in Model.Room) {
        <tr>
            <td>
                @Html.DisplayFor(modelItem => item.Cinema.Name)
            </td>
            <td>
                @Html.DisplayFor(modelItem => item.RoomNumber)
            </td>
            <td>
                @Html.DisplayFor(modelItem => item.RowCount)
            </td>
            <td>
                @Html.DisplayFor(modelItem => item.SeatsPerRow)
            </td>
            <td>
                <a asp-page="./Edit" asp-route-id="@item.Id" class="link-edit">Edit</a> |
                <a asp-page="./Details" asp-route-id="@item.Id" class="link-details">Details</a> |
                <a asp-page="./Delete" asp-route-id="@item.Id" class="link-delete">Delete</a>
            </td>
        </tr>
}
    </tbody>
</table>
