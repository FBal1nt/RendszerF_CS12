@page
@model JegyMester.Pages.Room.CreateModel

    <h4>Room</h4>
    <hr />
    <div class="row">
    <div class="col-md-4">
    <form method="post">
    <div asp-validation-summary="ModelOnly" class="text-danger"></div>
            <div class="form-group">
                <label asp-for="Room.CinemaId" class="control-label"></label>
                <select asp-for="Room.CinemaId" class ="form-control" asp-items="ViewBag.CinemaId" ></select>
            </div>
            <div class="form-group">
                <label asp-for="Room.RoomNumber" class="control-label"></label>
                <input asp-for="Room.RoomNumber" class="form-control" />
                <span asp-validation-for="Room.RoomNumber" class="text-danger"></span>
            </div>
            <div class="form-group">
                <label asp-for="Room.RowCount" class="control-label"></label>
                <input asp-for="Room.RowCount" class="form-control" />
                <span asp-validation-for="Room.RowCount" class="text-danger"></span>
            </div>
            <div class="form-group">
                <label asp-for="Room.SeatsPerRow" class="control-label"></label>
                <input asp-for="Room.SeatsPerRow" class="form-control" />
                <span asp-validation-for="Room.SeatsPerRow" class="text-danger"></span>
            </div>
            <div class="form-group">
                <input type="submit" value="Create" class="btn btn-primary" />
            </div>
        </form>
    </div>
</div>

<div>
    <a asp-page="/AdminIndex">Vissza az Admin oldalra</a>
</div>

