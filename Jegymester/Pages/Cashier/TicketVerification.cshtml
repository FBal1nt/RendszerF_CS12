@page
@model JegyMester.Pages.Cashier.VerificationModel

@{
    ViewData["Title"] = "Ticket Scanner";
}

<h1>🎫 Ticket Scanner</h1>

<form method="post" id="antiForgeryForm">
    @Html.AntiForgeryToken()
</form>

<div class="mb-3">
    <input type="text" id="scanInput" class="form-control form-control-lg"
           placeholder="Scan or enter ticket code..."
           autofocus />
</div>

<div class="form-check mb-3">
    <input class="form-check-input" type="checkbox" id="autoVerify" checked>
    <label class="form-check-label">
        Auto verify
    </label>
</div>

<div id="result"></div>

<a asp-page="/Cashier/Index" class="btn btn-secondary mt-3">Back</a>

<script>
    const input = document.getElementById("scanInput");
    const result = document.getElementById("result");
    const autoVerify = document.getElementById("autoVerify");
    const token = document.querySelector('input[name="__RequestVerificationToken"]').value;

            input.addEventListener("keypress", function(e) {
                if (e.key === "Enter") {
                    e.preventDefault(); // EZ HIÁNYZIK
                    handleScan();
                }
            });

    function handleScan() {
        const code = input.value.trim();
        if (!code) return;

        const handler = autoVerify.checked ? "ScanAndVerify" : "Scan";

            fetch(`?handler=${handler}`, {
        method: "POST",
        headers: {
            "Content-Type": "application/x-www-form-urlencoded",
            "RequestVerificationToken": document.querySelector('input[name="__RequestVerificationToken"]').value
        },
        body: "code=" + code
    })
    .then(async res => {
        if (!res.ok) {
            const text = await res.text();
            throw new Error(`HTTP ${res.status}: ${text}`);
        }
        return res.json();
    })
    .then(data => {
        if (!data) throw new Error("No data received");
        renderResult(data);
        input.value = "";
        input.focus();
    })
    .catch(err => {
        console.error(err);
        result.innerHTML = `
            <div class="alert alert-danger fs-4">
                ❌ ${err.message}
            </div>
        `;
        playError();
    });
    }

    function renderResult(data) {
        if (!data.ok) {
            result.innerHTML = `
                <div class="alert alert-danger fs-4">
                    ❌ ${data.message}
                </div>
            `;
            playError();
            return;
        }

        let html = `
            <div class="alert alert-success fs-5">
                🎟️ ${data.row}. sor, ${data.seat}. szék <br>
                Type: ${data.type} <br>
        `;

        if (!autoVerify.checked) {
            html += `
                <button class="btn btn-primary mt-2"
                        onclick="verify(${data.ticketId})">
                    Verify
                </button>
            `;
        } else {
            html += `<br><span class="badge bg-success fs-5">${data.message}</span>`;
        }

        html += `</div>`;
        result.innerHTML = html;

        playSuccess();
    }

    function verify(id) {
        fetch(`?handler=Verify&id=${id}`, {
            method: "POST"
        })
        .then(() => location.reload());
    }

    // 🔊 kis UX boost
    function playSuccess() {
        new Audio("https://www.soundjay.com/buttons/sounds/button-3.mp3").play();
        document.body.style.backgroundColor = "green";
        setTimeout(() => document.body.style.backgroundColor = "", 500);
    }

    function playError() {
        new Audio("https://www.soundjay.com/buttons/sounds/button-10.mp3").play();
        document.body.style.backgroundColor = "red";
        setTimeout(() => document.body.style.backgroundColor = "", 500);
    }
</script>