@page
@model JegyMester.Pages.Cashier.Sell_ticket.CreateModel

@using JegyMester.DataContext.Enums

@{
    ViewData["Title"] = "Sell Tickets";
    Layout = "~/Pages/Shared/_Layout.cshtml";
}

<h1>Sell Tickets</h1>

<form method="post" id="sellForm">
    @Html.AntiForgeryToken()
    <div class="mb-3">
        <label class="form-label">Screening</label>
        <select id="screeningSelect" class="form-select">
            <option value="">-- Select screening --</option>
            @foreach (var s in Model.AvailableScreenings)
            {
                <option value="@s.Id">@s.Film?.Title - @s.StartTime.ToString("g")</option>
            }
        </select>
    </div>

    <div id="seatGrid" class="mt-4"></div>
    <div id="hiddenInputs"></div>
    <div id="selectedInfo" class="mt-3"></div>
    <div>
    <button type="button" id="addRowBtn" class="btn btn-success">Add Ticket</button>
    </div>

    <div id="rowsContainer" class="mb-3"></div>

    <div class="mb-3">
        <input type="submit" value="Complete Sale" class="btn btn-primary" />
        <a asp-page="./Index" class="btn btn-secondary">Cancel</a>
    </div>
</form>
@section Scripts {
<script>
        document.addEventListener("DOMContentLoaded", function () {

            const container = document.getElementById('rowsContainer');
            const screeningSelect = document.getElementById('screeningSelect');
            const addBtn = document.getElementById('addRowBtn');

            addBtn.addEventListener('click', function () {
                const screenId = screeningSelect.value;

                if (!screenId) {
                    alert("Select a screening first!");
                    return;
                }

                const newRow = createRow(screenId);
                container.appendChild(newRow);
            });

            document.getElementById("sellForm").addEventListener("submit", function () {
            const rows = container.children;

            for (let i = 0; i < rows.length; i++) {
                const hidden = rows[i].querySelector(`input[name^="Items"][name$=".ScreeningId"]`);
                hidden.value = screeningSelect.value;
            }
});
                    document.getElementById("sellForm").addEventListener("submit", function (e) {
                    if (container.children.length === 0) {
                        e.preventDefault();
                        alert("Add at least one ticket!");
                    }
        });

        function reindex() {
            const rows = container.children;
            for (let i = 0; i < rows.length; i++) {
                rows[i].querySelectorAll("input, select").forEach(el => {
                    el.name = el.name.replace(/Items\[\d+\]/, `Items[${i}]`);
                });
            }
            index = rows.length;
}

        removeBtn.onclick = () => {
            row.remove();
            reindex();
        };

        });

                const seatGrid = document.getElementById("seatGrid");

        let selectedSeats = [];

        screeningSelect.addEventListener("change", loadSeats);

        function loadSeats() {
            const screeningId = screeningSelect.value;
            if (!screeningId) return;

            fetch(`?handler=TakenSeats&screeningId=${screeningId}`)
                .then(res => res.json())
                .then(taken => {
                    renderGrid(taken);
                });
        }

        function renderGrid(takenSeats) {
        function renderGrid(takenSeats) {
            seatGrid.innerHTML = "";
            selectedSeats = [];

            const rows = 10;      // állítható
            const seatsPerRow = 12;

            for (let r = 1; r <= rows; r++) {
                const rowDiv = document.createElement("div");

                const label = document.createElement("span");
                label.className = "row-label";
                label.textContent = r + ". sor";
                rowDiv.appendChild(label);

                for (let s = 1; s <= seatsPerRow; s++) {
                    const seat = document.createElement("div");
                    seat.className = "seat";

                    const isTaken = takenSeats.some(t => t.row === r && t.seatNumber === s);

                    if (isTaken) {
                        seat.classList.add("taken");
                    } else {
                        seat.classList.add("free");

                        seat.onclick = () => toggleSeat(seat, r, s);
                    }

                    seat.textContent = s;
                    rowDiv.appendChild(seat);
                }

                seatGrid.appendChild(rowDiv);
            }
        }

        function toggleSeat(element, row, seatNumber) {
            const index = selectedSeats.findIndex(s => s.row === row && s.seatNumber === seatNumber);

            if (index >= 0) {
                selectedSeats.splice(index, 1);
                element.classList.remove("selected");
                element.classList.add("free");
            } else {
                selectedSeats.push({ row, seatNumber });
                element.classList.remove("free");
                element.classList.add("selected");
            }

            syncForm();
        }

                function syncForm() {
                    const container = document.getElementById("hiddenInputs");
                    container.innerHTML = "";

                    selectedSeats.forEach((seat, i) => {
                        container.innerHTML += `
                            <input type="hidden" name="Items[${i}].ScreeningId" value="${screeningSelect.value}" />
                            <input type="hidden" name="Items[${i}].Row" value="${seat.row}" />
                            <input type="hidden" name="Items[${i}].SeatNumber" value="${seat.seatNumber}" />
                            <input type="hidden" name="Items[${i}].Type" value="0" />
                        `;
                    });
                }

                 function syncForm() {
                    const container = document.getElementById("hiddenInputs");
                    const info = document.getElementById("selectedInfo");

                    container.innerHTML = "";

                    let text = "Selected: ";

                    selectedSeats.forEach((seat, i) => {
                        container.innerHTML += `
                            <input type="hidden" name="Items[${i}].ScreeningId" value="${screeningSelect.value}" />
                            <input type="hidden" name="Items[${i}].Row" value="${seat.row}" />
                            <input type="hidden" name="Items[${i}].SeatNumber" value="${seat.seatNumber}" />
                            <input type="hidden" name="Items[${i}].Type" value="0" />
                        `;

                        text += `${seat.row}. sor ${seat.seatNumber}. szék, `;
                    });

                    info.textContent = selectedSeats.length ? text : "";
                }
</script>
}
<style>
    .seat {
        width: 35px;
        height: 35px;
        margin: 4px;
        display: inline-flex;
        justify-content: center;
        align-items: center;
        border-radius: 6px;
        cursor: pointer;
        font-size: 12px;
    }

    .free {
        background-color: #28a745;
        color: white;
    }

    .taken {
        background-color: #dc3545;
        color: white;
        cursor: not-allowed;
    }

    .selected {
        background-color: #007bff;
        color: white;
    }

    .row-label {
        width: 60px;
        display: inline-block;
    }
</style>