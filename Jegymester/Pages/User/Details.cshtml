@page
@model JegyMester.Pages.User.DetailsModel

<div>
    <h4>Felhasználó adatai</h4>
    <hr />
    <dl class="row">
        <dt class="col-sm-2">Név</dt>
        <dd class="col-sm-10">@Model.User.Name</dd>

        <dt class="col-sm-2">E-mail</dt>
        <dd class="col-sm-10">@Model.User.Email</dd>

        <dt class="col-sm-2">Telefonszám</dt>
        <dd class="col-sm-10">@Model.User.PhoneNumber</dd>

        <dt class="col-sm-2">Szerepek</dt>
        <dd class="col-sm-10">
            @string.Join(", ", Model.User.Roles.Select(r => r.Name))
        </dd>
    </dl>
</div>

<div class="mt-3">
    <a asp-page="./Edit" asp-route-id="@Model.User.Id" class="btn btn-primary">Szerkesztés</a>
    <a asp-page="/AdminIndex" class="btn btn-secondary">Vissza</a>
</div>
