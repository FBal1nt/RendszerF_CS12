@page
@model JegyMester.Pages.User.IndexModel

<p>
    <a asp-page="Create" class="btn btn-success">Create New</a>
    <a asp-page="/AdminIndex" class="btn btn-secondary">Vissza az Admin oldalra</a>
</p>
<table class="table">
    <thead>
        <tr>
            <th>
                @Html.DisplayNameFor(model => model.User[0].Name)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.User[0].Email)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.User[0].PhoneNumber)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.User[0].Password)
            </th>
            <th>
                Szerepek
            </th>
            <th></th>
        </tr>
    </thead>
    <tbody>
@foreach (var item in Model.User) {
        <tr>
            <td>
                @Html.DisplayFor(modelItem => item.Name)
            </td>
            <td>
                @Html.DisplayFor(modelItem => item.Email)
            </td>
            <td>
                @Html.DisplayFor(modelItem => item.PhoneNumber)
            </td>
            <td>
                <div class="input-group">
                    <input id="pwd-@item.Id" type="password" readonly class="form-control form-control-sm" value="@item.Password" />
                    <button type="button" class="btn btn-sm btn-outline-secondary toggle-pwd" data-target="#pwd-@item.Id">Mutat</button>
                </div>
            </td>
            <td>
                @string.Join(", ", item.Roles.Select(r => r.Name))
            </td>
            <td>
                <a asp-page="./Edit" asp-route-id="@item.Id" class="link-edit">Edit</a> |
                <a asp-page="./Details" asp-route-id="@item.Id" class="link-details">Details</a> |
                <a asp-page="./Delete" asp-route-id="@item.Id" class="link-delete">Delete</a>
            </td>
        </tr>
}
    </tbody>
</table>

<script>
    document.addEventListener('DOMContentLoaded', function () {
        document.querySelectorAll('.toggle-pwd').forEach(function (btn) {
            btn.addEventListener('click', function () {
                var selector = btn.getAttribute('data-target');
                var input = document.querySelector(selector);
                if (!input) return;
                if (input.type === 'password') {
                    input.type = 'text';
                    btn.textContent = 'Rejt';
                } else {
                    input.type = 'password';
                    btn.textContent = 'Mutat';
                }
            });
        });
    });
</script>
