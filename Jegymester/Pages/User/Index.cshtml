@page
@model JegyMester.Pages.User.IndexModel

<p>
    <a asp-page="Create" class="btn btn-success">Új felhasználó</a>
    <a asp-page="/AdminIndex" class="btn btn-secondary">Vissza az Admin oldalra</a>
</p>

<table class="table table-striped">
    <thead>
        <tr>
            <th>Név</th>
            <th>E-mail</th>
            <th>Telefonszám</th>
            <th>Szerepek</th>
            <th>Műveletek</th>
        </tr>
    </thead>
    <tbody>
        @foreach (var item in Model.User)
        {
            <tr>
                <td>@item.Name</td>
                <td>@item.Email</td>
                <td>@item.PhoneNumber</td>
                <td>@string.Join(", ", item.Roles.Select(r => r.Name))</td>
                <td>
                    <a asp-page="./Edit" asp-route-id="@item.Id">Szerkesztés</a> |
                    <a asp-page="./Details" asp-route-id="@item.Id">Részletek</a> |
                    <a asp-page="./Delete" asp-route-id="@item.Id">Törlés</a>
                </td>
            </tr>
        }
    </tbody>
</table>
