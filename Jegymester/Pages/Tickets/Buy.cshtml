        function updateUI() {
    const list = document.getElementById("selectedSeatsList");
    const btn = document.getElementById("submitBtn");
    const jsonInput = document.getElementById("selectedTicketsJson");

    if (selectedTickets.length === 0) {
        list.innerHTML = '<li class="list-group-item text-muted">Nincs választott hely.</li>';
        btn.disabled = true;
        btn.innerText = "Válassz legalább egy helyet!";
    } else {
        // Itt a változás: hozzáadunk egy törlés gombot (btn-outline-danger)
        list.innerHTML = selectedTickets.map((t, index) => 
            `<li class="list-group-item d-flex justify-content-between align-items-center">
                <div>
                    <strong>${t.row}. sor, ${t.column}. szék</strong> <br/>
                    <small class="text-muted">${t.type} - ${t.price} Ft</small>
                </div>
                <button type="button" class="btn btn-outline-danger btn-sm" onclick="removeSeat(${t.seatNumber})">
                    <i class="bi bi-trash"></i> Törlés
                </button>
            </li>`
        ).join("");
        
        const total = selectedTickets.reduce((sum, t) => sum + t.price, 0);
        btn.disabled = false;
        btn.innerText = `${selectedTickets.length} jegy megvétele (${total} Ft)`;
    }
    jsonInput.value = JSON.stringify(selectedTickets);
}

// Új függvény a listából való törléshez
function removeSeat(seatNumber) {
    // 1. Megkeressük a gombot a táblázatban, hogy visszaállítsuk a színét
    const tableBtn = document.querySelector(`button[data-seat="${seatNumber}"]`);
    if (tableBtn) {
        tableBtn.classList.replace("btn-warning", "btn-success");
    }

    // 2. Kivesszük a listából
    selectedTickets = selectedTickets.filter(t => t.seatNumber !== seatNumber);

    // 3. Frissítjük a felületet
    updateUI();
}
    </script>
}